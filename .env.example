# CampusPulse AI - Environment Configuration Example
# Copy this file to .env and configure your variables

# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Application Mode: demo | gmail
APP_MODE=demo

# AI Provider: gemini | mock
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# University Domain Filter (Comma-separated)
ALLOWED_UNIVERSITY_DOMAINS=northbridgeuniversity.edu,university.edu,srmist.edu.in

# Google OAuth Credentials (for Live Gmail Mode)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/oauth/callback

# Google Maps API (Optional for enhanced live map rendering)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Security & Sessions
JWT_SECRET=super_secret_campuspulse_jwt_key_change_in_production
SESSION_SECRET=super_secret_session_key
